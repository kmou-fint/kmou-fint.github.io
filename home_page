/* ---------- 논문 통계 ---------- */
const journalOf = p => p.venue.split(",")[0].trim();
(function metrics(){
  // 학술지별
  const counts = {};
  scie.forEach(p => counts[journalOf(p)] = (counts[journalOf(p)]||0)+1);
  let rows = Object.entries(counts).sort((a,b) => b[1]-a[1]);
  if (rows.length > 6){ const other = rows.slice(5).reduce((s,r) => s+r[1], 0); rows = rows.slice(0,5).concat([["Other journals", other]]); }
  const ramp = ["#0F2B3A","#2A5A74","#5A8FA6","#93BDCB","#CFE2E9","#E6EEF1"];
  const total = scie.length, R = 100, SW = 34, gap = 2/R;
  let a0 = -Math.PI/2;
  const arcs = rows.map((r,i) => {
    const span = r[1]/total*2*Math.PI, a1 = a0 + span;
    const s = a0 + gap/2, e = a1 - gap/2;
    const p = t => [120 + R*Math.cos(t), 120 + R*Math.sin(t)];
    const [x0,y0] = p(s), [x1,y1] = p(Math.max(e, s+0.001));
    const d = span >= 2*Math.PI - 0.001
      ? `M${120+R} 120A${R} ${R} 0 1 1 ${120-R} 120A${R} ${R} 0 1 1 ${120+R} 120`
      : `M${x0} ${y0}A${R} ${R} 0 ${span > Math.PI ? 1 : 0} 1 ${x1} ${y1}`;
    a0 = a1;
    return `<path d="${d}" fill="none" stroke="${ramp[i]}" stroke-width="${SW}"><title>${esc(r[0])}: ${r[1]} (${(r[1]/total*100).toFixed(1)}%)</title></path>`;
  }).join("");
  $("#donut").innerHTML = `
    <svg viewBox="0 0 240 240" role="img" aria-label="SCIE papers by journal">
      ${arcs}
      <text x="120" y="114" text-anchor="middle" font-size="40" font-weight="600" fill="#0F2B3A" font-family="inherit">${total}</text>
      <text x="120" y="140" text-anchor="middle" font-size="13" fill="#58707C" font-family="inherit">SCIE papers</text>
    </svg>
    <table class="jtable">
      <thead><tr><th>Journal · 학술지</th><th class="n">Papers</th><th class="n">Share</th></tr></thead>
      <tbody>${rows.map((r,i) => `<tr><td><span class="sw" style="background:${ramp[i]}"></span>${esc(r[0])}</td><td class="n">${r[1]}</td><td class="n">${(r[1]/total*100).toFixed(1)}%</td></tr>`).join("")}</tbody>
    </table>`;

  $("#home-donut").innerHTML = $("#donut").innerHTML;   // 홈에도 같은 차트 표시

  // 연도별
  const ys = scie.map(p => p.year), y0 = Math.min(...ys), y1 = Math.max(...ys);
  const years = []; for (let y = y0; y <= y1; y++) years.push([y, scie.filter(p => p.year === y).length]);
  const max = Math.max(...years.map(r => r[1]), 1), bw = 44, gapx = 22, left = 10, h = 170, top = 28;
  const w = left*2 + years.length*(bw+gapx) - gapx;
  $("#bars").innerHTML = `<svg width="${w*1.2}" height="${(h+top+30)*1.2}" viewBox="0 0 ${w} ${h+top+30}" role="img" aria-label="SCIE papers by year">
    <line x1="${left}" y1="${top+h}" x2="${w-left}" y2="${top+h}" stroke="#A7C3CF"/>
    ${years.map(([y,n],i) => { const x = left + i*(bw+gapx), bh = n/max*h; return `
      <rect x="${x}" y="${top+h-bh}" width="${bw}" height="${bh}" rx="3" fill="#2A5A74"><title>${y}: ${n}</title></rect>
      <text x="${x+bw/2}" y="${top+h-bh-8}" text-anchor="middle" font-size="14" font-weight="600" fill="#0F2B3A" font-family="inherit">${n}</text>
      <text x="${x+bw/2}" y="${top+h+20}" text-anchor="middle" font-size="13" fill="#58707C" font-family="inherit">${y}</text>`; }).join("")}
  </svg>`;

  // JCR 백분위 분포
  const bandRows = BANDS.map(([k,en,ko,col]) => [k,en,ko,col,bandCount(k)]);
  $("#band").innerHTML = `
    <div class="band" role="img" aria-label="JCR percentile distribution">${bandRows.filter(r => r[4] > 0).map(r =>
      `<div style="flex:${r[4]};background:${r[3]};color:${r[0]==="none"||r[0]==="over20" ? "#0F2B3A" : "#fff"}" title="${esc(r[1])}: ${r[4]}">${r[4]}</div>`).join("")}</div>
    <div class="band-legend">${bandRows.map(r => `<span><span class="sw" style="background:${r[3]};border:1px solid #A7C3CF"></span>${esc(r[1])} · ${esc(r[2])}: ${r[4]}</span>`).join("")}</div>
    ${notEntered ? `<p class="stats-note">JCR percentile has not been entered for ${notEntered} papers. Enter each journal's JCR percentile for the year of publication in the publication list and this chart updates.<br><span class="ko">논문 ${notEntered}편의 JCR 백분위가 아직 입력되지 않았습니다. 논문 목록에 게재 연도의 학술지 JCR 백분위를 입력하면 자동으로 반영됩니다.</span></p>` : ""}`;
})();

