$("#apply").addEventListener("submit", async e => {
  e.preventDefault();
  const f = e.target, st = $("#apply-status");
  if (!f.reportValidity()) return;
  const d = Object.fromEntries(new FormData(f).entries());
  const subject = `[FINT] Application enquiry – ${d.name}`;
  const body = `Name: ${d.name}\nE-mail: ${d.email}\nAffiliation / status: ${d.affiliation}\nArea of interest: ${d.area}\n\n${d.message}`;
  if (LAB.formEndpoint){
    st.textContent = "Sending…";
    try{
      const r = await fetch(LAB.formEndpoint, { method:"POST", headers:{ "Accept":"application/json", "Content-Type":"application/json" },
        body: JSON.stringify({ ...d, _subject: subject }) });
      st.textContent = r.ok ? "Sent. We will get back to you by e-mail. · 전송되었습니다." : "Could not send. Please e-mail the advisors directly. · 전송에 실패했습니다. 교수님께 직접 메일을 보내 주세요.";
      if (r.ok) f.reset();
    } catch { st.textContent = "Could not send. Please e-mail the advisors directly. · 전송에 실패했습니다. 교수님께 직접 메일을 보내 주세요."; }
  } else {
    location.href = `mailto:${pis.map(m => m.email).join(",")}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    st.textContent = "If your mail app did not open, e-mail the advisors directly. · 메일 앱이 열리지 않으면 교수님께 직접 메일을 보내 주세요.";
