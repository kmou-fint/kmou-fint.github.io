/* ---------- 첫 화면 레이더 (임시) ---------- */
(function radar(){
  const cv = $("#radar"), ctx = cv.getContext("2d");
  const css = getComputedStyle(document.documentElement), C = k => css.getPropertyValue(k).trim();
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let W = 0, R = 0;
  function size(){ const d = devicePixelRatio||1; W = cv.clientWidth; cv.width = cv.height = W*d; ctx.setTransform(d,0,0,d,0,0); R = W/2; }
  const ships = Array.from({length:9}, (_,i) => ({
    x: Math.cos(i*0.7)*(0.25+0.6*((i*37)%10)/10),
    y: Math.sin(i*1.3)*(0.25+0.6*((i*53)%10)/10),
    c: (i*41)%360 * Math.PI/180, v: 0.0004 + ((i*7)%5)*0.00012, seen: 0, track: []
  }));
  ships[0].focus = true; ships[1].focus = true;
  const coast = [[-1,-0.35],[-0.72,-0.42],[-0.55,-0.62],[-0.38,-0.7],[-0.3,-0.95],[-0.2,-1],[-1,-1]];
  let ang = 0, last = performance.now();
  function frame(now){
    const dt = Math.min(50, now-last); last = now;
    if (cv.clientWidth === 0){ requestAnimationFrame(frame); return; }
    if (cv.clientWidth !== W) size();
    ctx.clearRect(0,0,W,W); ctx.save(); ctx.translate(R,R);
    ctx.fillStyle = "rgba(167,195,207,.18)";
    ctx.beginPath(); coast.forEach(([x,y],i) => i ? ctx.lineTo(x*R,y*R) : ctx.moveTo(x*R,y*R)); ctx.closePath(); ctx.fill();
    ctx.strokeStyle = "#3E6577"; ctx.lineWidth = 1;
    for (let k=1;k<=4;k++){ ctx.beginPath(); ctx.arc(0,0,R*k/4.2,0,7); ctx.stroke(); }
    ctx.globalAlpha = .35;
    for (let a=0;a<12;a++){ ctx.beginPath(); ctx.moveTo(0,0); const t=a*Math.PI/6; ctx.lineTo(Math.cos(t)*R,Math.sin(t)*R); ctx.stroke(); }
    ctx.globalAlpha = 1;
    if (!still){
      if (ctx.createConicGradient){
        const g = ctx.createConicGradient(ang-0.9,0,0);
        g.addColorStop(0,"rgba(143,208,181,0)"); g.addColorStop(0.14,"rgba(143,208,181,.22)"); g.addColorStop(0.1433,"rgba(143,208,181,0)");
        ctx.fillStyle = g; ctx.beginPath(); ctx.arc(0,0,R,0,7); ctx.fill();
      }
      ctx.strokeStyle = C("--echo"); ctx.globalAlpha = .8;
      ctx.beginPath(); ctx.moveTo(0,0); ctx.lineTo(Math.cos(ang)*R, Math.sin(ang)*R); ctx.stroke(); ctx.globalAlpha = 1;
    }
    ships.forEach(s => {
      if (!still){
        s.x += Math.sin(s.c)*s.v*dt/16; s.y -= Math.cos(s.c)*s.v*dt/16;
        if (Math.hypot(s.x,s.y) > 0.95){ s.c += Math.PI; s.track = []; }
        const a = (Math.atan2(s.y,s.x)+2*Math.PI)%(2*Math.PI), sw = (ang%(2*Math.PI)+2*Math.PI)%(2*Math.PI);
        let diff = sw - a; if (diff<0) diff += 2*Math.PI;
        if (diff < 0.08){ s.seen = 1; s.track.push([s.x,s.y]); if (s.track.length>14) s.track.shift(); }
        s.seen = Math.max(0.25, s.seen - dt/5200);
      } else s.seen = 1;
      const px = s.x*R, py = s.y*R, col = s.focus ? C("--signal") : C("--echo");
      ctx.fillStyle = col;
      s.track.forEach(([tx,ty],i) => { ctx.globalAlpha = (i/s.track.length)*.5*s.seen; ctx.beginPath(); ctx.arc(tx*R,ty*R,1.4,0,7); ctx.fill(); });
      ctx.globalAlpha = s.seen;
      ctx.save(); ctx.translate(px,py); ctx.rotate(s.c);
      ctx.beginPath(); ctx.moveTo(0,-7); ctx.lineTo(4.5,5); ctx.lineTo(-4.5,5); ctx.closePath();
      ctx.strokeStyle = col; ctx.lineWidth = 1.5; ctx.stroke();
      ctx.beginPath(); ctx.moveTo(0,-7); ctx.lineTo(0,-7-s.v*60000); ctx.stroke();
      ctx.restore(); ctx.globalAlpha = 1;
    });
    const [a,b] = ships;
    ctx.setLineDash([4,5]); ctx.strokeStyle = C("--signal"); ctx.globalAlpha = .6;
    ctx.beginPath(); ctx.moveTo(a.x*R,a.y*R); ctx.lineTo(b.x*R,b.y*R); ctx.stroke();
    ctx.setLineDash([]); ctx.globalAlpha = 1; ctx.restore();
    ang += dt/1400;
    if (!still) requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
  addEventListener("hashchange", () => { if (still) setTimeout(() => requestAnimationFrame(frame), 0); });
})();
