});

/* ---------- 메뉴 이동 ---------- */
const SECTIONS = ["home","about","research","members","publications","metrics","awards","news","contact"];
function route(){
  const id = SECTIONS.includes(location.hash.slice(1)) ? location.hash.slice(1) : "home";
  SECTIONS.forEach(s => document.getElementById(s).classList.toggle("active", s===id));
  const navId = id === "metrics" ? "publications" : id;
  document.querySelectorAll("nav a").forEach(a => {
