<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>FINT · Maritime Autonomy Science & Technology</title>
<meta name="description" content="FINT (Fluid dynamics and Intelligent Navigation Technologies), a joint laboratory at Korea Maritime & Ocean University — ship hydrodynamics and control (CFD) and collision avoidance for autonomous ships.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* =========================================================
   색상·글꼴 — 여기 값만 바꾸면 사이트 전체 분위기가 바뀝니다
   ========================================================= */
:root{
  --paper:#F4F8F9;
  --chart:#DDEAEF;
  --depth:#A7C3CF;
  --ink:#0F2B3A;
  --sounding:#58707C;
  --signal:#C46F12;
  --sea:#0F2B3A;
  --echo:#8FD0B5;
  --radius:6px;
  --font:'IBM Plex Sans KR', system-ui, sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--ink);font-family:var(--font);font-size:17px;line-height:1.65;-webkit-font-smoothing:antialiased}
a{color:inherit}
img{max-width:100%;display:block}
ul,ol{list-style:none}
:focus-visible{outline:2px solid var(--signal);outline-offset:3px}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
.ko{color:var(--sounding);font-size:.92em}
p+p{margin-top:.8em}

/* ---------- 상단 ---------- */
header{position:sticky;top:0;z-index:20;background:rgba(244,248,249,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--chart)}
.bar{display:flex;align-items:center;justify-content:space-between;height:68px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;letter-spacing:-.01em}
.brand img{height:38px;width:auto}
.brand .sep{width:1px;height:30px;background:var(--depth)}
.brand svg{flex:none}
.brand b{font-weight:700;font-size:20px;letter-spacing:.04em;line-height:1.1}
.brand small{display:block;font-weight:400;font-size:12px;color:var(--sounding);line-height:1.2;margin-top:2px}
nav ul{display:flex;gap:2px}
nav a{display:block;padding:8px 11px;border-radius:var(--radius);text-decoration:none;font-size:15px;color:var(--sounding)}
nav a:hover{color:var(--ink);background:var(--chart)}
nav a[aria-current="page"]{color:var(--ink);font-weight:600}
.menu-btn{display:none;background:none;border:1px solid var(--depth);border-radius:var(--radius);padding:6px 12px;font:inherit;font-size:14px;color:var(--ink);cursor:pointer}
@media (max-width:960px){
  .menu-btn{display:block}
  .brand small{display:none}
  nav{position:absolute;top:68px;left:0;right:0;background:var(--paper);border-bottom:1px solid var(--chart);display:none}
  nav.open{display:block}
  nav ul{flex-direction:column;padding:8px 16px 16px}
}

/* ---------- 공통 ---------- */
main section{display:none;padding:64px 0 96px}
main section.active{display:block}
h1{font-size:clamp(32px,4.4vw,50px);line-height:1.14;letter-spacing:-.025em;font-weight:700}
h2{font-size:28px;line-height:1.25;letter-spacing:-.02em;font-weight:600;margin-bottom:6px}
h3{font-size:20px;line-height:1.35;font-weight:600}
.page-head{margin-bottom:48px;max-width:720px}
.page-head p{margin-top:12px;color:var(--sounding)}
.btn{display:inline-block;padding:11px 20px;border-radius:var(--radius);text-decoration:none;font-weight:500;font-size:15px;border:1px solid var(--ink);background:none;font-family:inherit;cursor:pointer;color:var(--ink)}
.btn.primary{background:var(--ink);color:var(--paper)}
.btn:hover{background:var(--chart);color:var(--ink)}
.more{display:inline-block;margin-top:16px;font-size:15px;font-weight:500}
.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px}
.tags span{font-size:13px;padding:3px 10px;border-radius:20px;background:var(--chart);color:var(--ink)}

/* ---------- 홈 ---------- */
#home{padding-top:40px}
.hero{display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center}
.hero .univ{font-size:15px;color:var(--sounding);margin-bottom:14px}
.hero p.lead{font-size:18px;margin-top:22px;max-width:34em}
.hero .ko{margin-top:10px;max-width:34em}
.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
.radar{position:relative;aspect-ratio:1;border-radius:50%;background:var(--sea);overflow:hidden;box-shadow:0 0 0 10px var(--chart)}
.radar canvas{width:100%;height:100%;display:block}
.scene-caption{margin-top:22px;font-size:13px;color:var(--sounding);text-align:center}
@media (max-width:900px){.hero{grid-template-columns:1fr}.radar-box{max-width:420px;width:100%;margin:0 auto}}

.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:20px 24px;margin-top:80px;padding-top:32px;border-top:1px solid var(--depth)}
.stat{display:block;text-decoration:none;padding:4px 0}
.stat b{display:block;font-size:40px;line-height:1;font-weight:600;letter-spacing:-.03em}
.stat span{display:block;margin-top:8px;font-size:15px}
.stat .ko{display:block;font-size:13px}
a.stat:hover b{color:var(--signal)}
.stats-note{margin-top:16px;font-size:13px;color:var(--sounding)}
.stats-note a{font-weight:500}
@media (max-width:760px){.stats{grid-template-columns:repeat(2,1fr)}}

.home-donut{margin-top:64px;padding-top:40px;border-top:1px solid var(--chart)}
.home-donut h2{font-size:24px}
.home-donut .ko{display:block;margin-bottom:24px}
.home-lower{display:grid;grid-template-columns:1.2fr .8fr;gap:56px;margin-top:80px;padding-top:48px;border-top:1px solid var(--chart)}
@media (max-width:900px){.home-lower{grid-template-columns:1fr}}
.area-mini{padding:16px 0;border-bottom:1px solid var(--chart)}
.area-mini strong{display:block}
.area-mini .ko{display:block}
.area-mini em{display:block;font-style:normal;font-size:14px;color:var(--sounding);margin-top:4px}

/* ---------- 연구 ---------- */
.areas{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--depth)}
.area{padding:36px 36px 40px 0;border-bottom:1px solid var(--depth)}
.area+.area{padding-left:36px;padding-right:0;border-left:1px solid var(--depth)}
.area .ko-title{color:var(--sounding);font-size:15px;margin:4px 0 8px}
.area .lead-by{font-size:14px;color:var(--sounding);margin-bottom:18px}
.area ul li{padding:10px 0;border-top:1px solid var(--chart)}
.area ul li .ko{display:block;font-size:14px}
@media (max-width:760px){.areas{grid-template-columns:1fr}.area,.area+.area{padding:28px 0;border-left:none}}
.joint{margin-top:56px;padding:36px;border-radius:var(--radius);background:var(--chart)}
.joint h2{font-size:24px}
.joint ul{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:24px}
.joint ul li strong{display:block;margin-bottom:6px}
.joint ul li .ko{display:block;font-size:14px}
@media (max-width:760px){.joint{padding:24px}.joint ul{grid-template-columns:1fr}}
.projects{width:100%;border-collapse:collapse;margin-top:16px;font-size:15px}
.projects th{text-align:left;font-weight:600;color:var(--sounding);padding:10px 12px 10px 0;border-bottom:1px solid var(--ink)}
.projects td{padding:14px 12px 14px 0;border-bottom:1px solid var(--chart);vertical-align:top}
.table-scroll{overflow-x:auto}

/* ---------- 구성원 ---------- */
.group{margin-bottom:56px}
.group>h2{font-size:22px;margin-bottom:20px}
.people{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:28px}
.person{display:flex;gap:16px;align-items:flex-start}
.avatar{flex:none;width:72px;height:72px;border-radius:50%;background:var(--chart);display:grid;place-items:center;font-weight:600;color:var(--sounding);overflow:hidden}
.avatar img{width:100%;height:100%;object-fit:cover}
.person .name,.pi .name{font-weight:600}
.person .role,.pi .role{font-size:14px;color:var(--sounding)}
.person .interest{font-size:14px;margin-top:4px}
.person a{font-size:14px}
.pi{display:grid;grid-template-columns:150px 1fr;gap:32px;align-items:start;padding:32px;background:#fff;border:1px solid var(--chart);border-radius:var(--radius)}
.pi+.pi{margin-top:24px}
.pi .avatar{width:150px;height:150px;font-size:30px;border-radius:12px}
.pi .name{font-size:22px}
.pi .field{margin-top:12px;font-size:15px}
.pi dl{display:grid;grid-template-columns:70px 1fr;gap:4px 16px;margin-top:16px;font-size:14px}
.pi dt{color:var(--sounding)}
.pi .cols{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:22px;padding-top:18px;border-top:1px solid var(--chart)}
.pi .cols h4{font-size:14px;font-weight:600;margin-bottom:8px}
.pi .cols li{font-size:13.5px;color:var(--sounding);padding:3px 0;line-height:1.45}
.pi .cols li b{color:var(--ink);font-weight:500;font-variant-numeric:tabular-nums;margin-right:6px}
.pi .links{margin-top:16px;font-size:14px}
@media (max-width:700px){.pi{grid-template-columns:1fr;padding:24px}.pi .avatar{width:120px;height:120px}.pi .cols{grid-template-columns:1fr}}

/* ---------- 논문 ---------- */
.pub-summary{margin-bottom:12px;max-width:760px}
.pub-summary+p{margin-bottom:28px}
.filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:32px}
.filters button{font:inherit;font-size:14px;padding:6px 14px;border-radius:20px;border:1px solid var(--depth);background:transparent;color:var(--ink);cursor:pointer}
.filters button[aria-pressed="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.year{display:grid;grid-template-columns:90px 1fr;gap:24px;padding:24px 0;border-top:1px solid var(--chart)}
.year>strong{font-size:22px;font-weight:600;color:var(--sounding)}
.pub{padding:0 0 18px}
.pub:last-child{padding-bottom:0}
.pub .t{font-weight:600}
.pub .a,.pub .v{font-size:15px;color:var(--sounding)}
.pub .a b{color:var(--ink);font-weight:600}
.kind{display:inline-block;font-size:12px;padding:1px 8px;border-radius:10px;background:var(--chart);margin:0 6px 4px 0;vertical-align:2px;font-weight:500}
.kind.jcr{background:#F4E3CF}
.kind.patent{background:#E7E3F4}
@media (max-width:620px){.year{grid-template-columns:1fr;gap:8px}}

/* ---------- 논문 통계 ---------- */
.metric{margin-top:56px;padding-top:40px;border-top:1px solid var(--chart)}
.metric:first-of-type{margin-top:0;padding-top:0;border-top:none}
.metric h2{font-size:22px}
.metric .ko{display:block;margin-bottom:20px}
.donut-wrap{display:grid;grid-template-columns:260px 1fr;gap:40px;align-items:center}
.donut-wrap svg{width:100%;height:auto}
.jtable{width:100%;border-collapse:collapse;font-size:15px}
.jtable th{text-align:left;font-weight:600;color:var(--sounding);padding:8px 10px 8px 0;border-bottom:1px solid var(--ink)}
.jtable td{padding:10px 10px 10px 0;border-bottom:1px solid var(--chart);vertical-align:middle}
.jtable td.n,.jtable th.n{text-align:right;font-variant-numeric:tabular-nums}
.sw{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:10px;vertical-align:-1px}
@media (max-width:700px){.donut-wrap{grid-template-columns:1fr}.donut-wrap svg{max-width:260px;margin:0 auto}}
.bars svg{max-width:100%;height:auto}
.band{display:flex;height:34px;border-radius:var(--radius);overflow:hidden;background:var(--chart);max-width:720px}
.band div{display:grid;place-items:center;font-size:13px;color:#fff;white-space:nowrap;overflow:hidden;border-right:2px solid var(--paper)}
.band div:last-child{border-right:none}
.band-legend{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:12px;font-size:14px}

/* ---------- 수상·소식 ---------- */
.news-list li{display:grid;grid-template-columns:110px 1fr;gap:20px;padding:18px 0;border-bottom:1px solid var(--chart)}
.news-list time,.news-list .y{color:var(--sounding);font-size:15px;font-variant-numeric:tabular-nums}
.news-list .ko{display:block}
.news-list .sub{display:block;font-size:14px;color:var(--sounding)}
@media (max-width:620px){.news-list li{grid-template-columns:1fr;gap:2px}}

/* ---------- 연락처·지원 ---------- */
.contact{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}
.contact-card+.contact-card{margin-top:28px;padding-top:28px;border-top:1px solid var(--chart)}
.contact-card h3{margin-bottom:10px}
.contact dl{display:grid;grid-template-columns:80px 1fr;gap:8px 16px;font-size:15px}
.contact dt{color:var(--sounding)}
.apply{padding:32px;border-radius:var(--radius);background:#fff;border:1px solid var(--chart)}
.apply h3{margin-bottom:4px}
.apply>.ko{display:block;margin-bottom:18px}
.apply label{display:block;font-size:14px;font-weight:500;margin:14px 0 6px}
.apply label span{color:var(--sounding);font-weight:400}
.apply input,.apply select,.apply textarea{width:100%;font:inherit;font-size:15px;padding:10px 12px;border:1px solid var(--depth);border-radius:var(--radius);background:var(--paper);color:var(--ink)}
.apply textarea{min-height:120px;resize:vertical}
.apply .btn{margin-top:20px}
.apply .hint{font-size:13px;color:var(--sounding);margin-top:12px}
.apply .status{margin-top:12px;font-size:14px;font-weight:500}
@media (max-width:800px){.contact{grid-template-columns:1fr}}

footer{border-top:1px solid var(--chart);padding:32px 0;font-size:14px;color:var(--sounding)}
footer .wrap{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}
footer img{height:30px;width:auto;opacity:.85}
footer .left{display:flex;align-items:center;gap:14px}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>

<header>
  <div class="wrap bar">
    <a class="brand" href="#home" aria-label="FINT home">
      <img src="img/kmou_logo.png" alt="Korea Maritime &amp; Ocean University" onerror="this.nextElementSibling.remove();this.remove()">
      <span class="sep"></span>
      <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true">
        <path d="M17 6v22" stroke="#0F2B3A" stroke-width="2" stroke-linecap="round"/>
        <path d="M9 12h16" stroke="#0F2B3A" stroke-width="2" stroke-linecap="round"/>
        <path d="M17 12L9 26M17 12l8 14" stroke="#A7C3CF" stroke-width="1.2"/>
        <circle cx="17" cy="5" r="2.4" fill="#C46F12"/>
        <path d="M5 29c3-2 5-2 8 0s5 2 8 0 5-2 8 0" stroke="#A7C3CF" stroke-width="1.5" fill="none" stroke-linecap="round"/>
      </svg>
      <span><b>FINT </b><small id="lab-full"></small></span>
    </a>
    <button class="menu-btn" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav id="site-nav">
      <ul>
        <li><a href="#home">Home</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#research">Research</a></li>
        <li><a href="#members">Members</a></li>
        <li><a href="#publications">Publications</a></li>
        <li><a href="#awards">Awards</a></li>
        <li><a href="#news">News</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<main>
  <!-- ================= HOME ================= -->
  <section id="home">
    <div class="wrap">
      <div class="hero">
        <div>
          <p class="univ" id="hero-univ"></p>
          <h1 id="hero-title"></h1>
          <p class="lead" id="hero-lead"></p>
          <p class="ko" id="hero-ko"></p>
          <div class="actions">
            <a class="btn primary" href="#research">Research</a>
            <a class="btn" href="#contact">Join the lab</a>
          </div>
        </div>
        <div class="radar-box">
          <div class="radar"><canvas id="radar" role="img" aria-label="Animated radar display with vessel targets"></canvas></div>
          <p class="scene-caption">Simulated traffic picture · 시뮬레이션 화면</p>
        </div>
      </div>

      <div class="stats" id="stats"></div>
      <p class="stats-note" id="stats-note"></p>

      <div class="home-donut">
        <h2>SCIE papers by journal</h2>
        <span class="ko">학술지별 SCIE 논문 수</span>
        <div class="donut-wrap" id="home-donut"></div>
        <a class="more" href="#metrics">Publication metrics</a>
      </div>

      <div class="home-lower">
        <div>
          <h2>Research areas</h2>
          <p class="ko">연구 분야</p>
          <div id="home-areas" style="margin-top:12px"></div>
          <a class="more" href="#research">Research in detail</a>
        </div>
        <div>
          <h2>News</h2>
          <p class="ko">소식</p>
          <ul class="news-list" id="home-news" style="margin-top:12px"></ul>
          <a class="more" href="#news">All news</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= ABOUT ================= -->
  <section id="about">
    <div class="wrap">
      <div class="page-head">
        <h1>About FINT </h1>
        <p>연구실 소개</p>
      </div>
      <div style="max-width:720px">
        <div id="about-en"></div>
        <div id="about-ko" style="margin-top:36px"></div>
      </div>
    </div>
  </section>

  <!-- ================= RESEARCH ================= -->
  <section id="research">
    <div class="wrap">
      <div class="page-head">
        <h1>Research</h1>
        <p>연구 분야 및 과제</p>
      </div>
      <div class="areas" id="areas"></div>
      <div class="joint" id="joint"></div>

      <h2 style="margin-top:72px">Projects</h2>
      <p class="ko">수행 과제</p>
      <div class="table-scroll">
        <table class="projects">
          <thead><tr><th>Project · 과제명</th><th>Funding · 지원기관</th><th>Period · 기간</th></tr></thead>
          <tbody id="projects"></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ================= MEMBERS ================= -->
  <section id="members">
    <div class="wrap">
      <div class="page-head">
        <h1>Members</h1>
        <p>구성원</p>
      </div>
      <div id="members-list"></div>
    </div>
  </section>

  <!-- ================= PUBLICATIONS ================= -->
  <section id="publications">
    <div class="wrap">
      <div class="page-head">
        <h1>Publications &amp; patents</h1>
        <p>논문 및 특허</p>
      </div>
      <p class="pub-summary" id="pub-summary"></p>
      <p><a href="#metrics">Publication metrics · 논문 통계 보기</a></p>
      <div class="filters" id="filters" role="group" aria-label="Filter publications"></div>
      <div id="pubs"></div>
    </div>
  </section>

  <!-- ================= METRICS ================= -->
  <section id="metrics">
    <div class="wrap">
      <div class="page-head">
        <h1>Publication metrics</h1>
        <p>논문 통계 · <a href="#publications">Back to the list</a></p>
      </div>
      <div class="metric">
        <h2>SCIE papers by journal</h2>
        <span class="ko">학술지별 SCIE 논문 수</span>
        <div class="donut-wrap" id="donut"></div>
      </div>
      <div class="metric">
        <h2>SCIE papers by year</h2>
        <span class="ko">연도별 SCIE 논문 수</span>
        <div class="bars" id="bars"></div>
      </div>
      <div class="metric">
        <h2>JCR percentile of the journals</h2>
        <span class="ko">게재 학술지의 JCR 백분위 분포</span>
        <div id="band"></div>
      </div>
    </div>
  </section>

  <!-- ================= AWARDS ================= -->
  <section id="awards">
    <div class="wrap">
      <div class="page-head">
        <h1>Awards</h1>
        <p>수상</p>
      </div>
      <ul class="news-list" id="awards-list"></ul>
    </div>
  </section>

  <!-- ================= NEWS ================= -->
  <section id="news">
    <div class="wrap">
      <div class="page-head">
        <h1>News</h1>
        <p>연구실 소식</p>
      </div>
      <ul class="news-list" id="news-list"></ul>
    </div>
  </section>

  <!-- ================= CONTACT ================= -->
  <section id="contact">
    <div class="wrap">
      <div class="page-head">
        <h1>Contact</h1>
        <p>연락처 및 연구실 지원</p>
      </div>
      <div class="contact">
        <div id="contact-cards"></div>
        <form class="apply" id="apply" novalidate>
          <h3>Join the lab</h3>
          <span class="ko">석·박사과정 지원 및 문의</span>
          <p id="recruit-text" style="font-size:15px"></p>
          <label for="f-name">Name · 이름</label>
          <input id="f-name" name="name" required autocomplete="name">
          <label for="f-email">E-mail · 이메일</label>
